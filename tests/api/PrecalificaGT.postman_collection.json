    {
      "name": "03 Flujo de negocio: solicitud → revisión → oferta aceptada",
      "item": [
        {
          "name": "Crear solicitud en BORRADOR",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código de respuesta 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const esquema = {\"type\": \"object\", \"required\": [\"id\", \"estado\", \"producto_codigo\", \"monto\", \"plazo_meses\"], \"properties\": {\"id\": {\"type\": \"integer\"}, \"estado\": {\"type\": \"string\", \"enum\": [\"BORRADOR\", \"EN_REVISION\", \"PREAPROBADA\", \"RECHAZADA\", \"ACEPTADA\", \"DECLINADA\", \"CANCELADA\", \"VENCIDA\"]}, \"producto_codigo\": {\"type\": \"string\"}, \"monto\": {\"type\": \"number\"}, \"plazo_meses\": {\"type\": \"integer\"}}};",
                  "pm.test(\"El cuerpo cumple el esquema\", function () {",
                  "    pm.response.to.have.jsonSchema(esquema);",
                  "});",
                  "pm.collectionVariables.set(\"solicitud_id\", pm.response.json().id);",
                  "pm.test(\"La solicitud nace en BORRADOR con los datos enviados\", function () {",
