    {
      "name": "02 Autenticación y sesión",
      "item": [
        {
          "name": "Registrar solicitante nuevo",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Correo y DPI únicos en cada ejecución (DPI sin historial en la central de riesgo)",
                  "const sufijo = Date.now().toString().slice(-8);",
                  "pm.collectionVariables.set(\"email_nuevo\", \"qa.\" + sufijo + \"@prueba.gt\");",
                  "pm.collectionVariables.set(\"dpi_nuevo\", \"8\" + sufijo + \"0101\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código de respuesta 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const esquema = {\"type\": \"object\", \"required\": [\"mensaje\", \"usuario\"], \"properties\": {\"usuario\": {\"type\": \"object\", \"required\": [\"id\", \"email\", \"rol\"], \"properties\": {\"rol\": {\"type\": \"string\"}}}}};",
                  "pm.test(\"El cuerpo cumple el esquema\", function () {",
                  "    pm.response.to.have.jsonSchema(esquema);",
                  "});",
                  "pm.test(\"La cuenta se crea con rol SOLICITANTE y estado ACTIVO\", function () {",
                  "    const u = pm.response.json().usuario;",
                  "    pm.expect(u.rol).to.eql(\"SOLICITANTE\");",
                  "    pm.expect(u.estado).to.eql(\"ACTIVO\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/registro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "registro"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Usuario QA Newman\",\n  \"dpi\": \"{{dpi_nuevo}}\",\n  \"email\": \"{{email_nuevo}}\",\n  \"telefono\": \"55551234\",\n  \"fecha_nacimiento\": \"1990-01-01\",\n  \"password\": \"{{password_nuevo}}\"\n}",
              "options": {
                "raw": {
