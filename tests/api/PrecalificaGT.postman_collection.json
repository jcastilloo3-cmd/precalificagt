                "api",
                "simulador"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"producto_codigo\": \"PERSONAL\",\n  \"monto\": 1000,\n  \"plazo_meses\": 70\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
