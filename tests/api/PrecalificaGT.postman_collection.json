                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código de respuesta 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const esquema = {\"type\": \"object\", \"required\": [\"token\", \"usuario\"], \"properties\": {\"token\": {\"type\": \"string\", \"minLength\": 20}, \"usuario\": {\"type\": \"object\", \"required\": [\"id\", \"email\", \"rol\", \"estado\"], \"properties\": {\"id\": {\"type\": \"integer\"}, \"rol\": {\"type\": \"string\"}, \"estado\": {\"type\": \"string\", \"enum\": [\"ACTIVO\"]}}}}};",
                  "pm.test(\"La respuesta trae token y usuario\", function () {",
                  "    pm.response.to.have.jsonSchema(esquema);",
                  "});",
                  "pm.collectionVariables.set(\"token_solicitante\", pm.response.json().token);",
