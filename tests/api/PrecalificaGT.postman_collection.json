    {
      "name": "01 Salud y catálogo (público)",
      "item": [
        {
          "name": "Verificar salud de la API",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código de respuesta 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const esquema = {\"type\": \"object\", \"required\": [\"estado\", \"servicio\"], \"properties\": {\"estado\": {\"type\": \"string\"}, \"servicio\": {\"type\": \"string\"}}};",
                  "pm.test(\"El cuerpo cumple el esquema\", function () {",
                  "    pm.response.to.have.jsonSchema(esquema);",
                  "});",
                  "pm.test(\"El servicio reporta estado ok\", function () {",
                  "    pm.expect(pm.response.json().estado).to.eql(\"ok\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            }
          }
        },
        {
          "name": "Listar productos activos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código de respuesta 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const esquema = {\"type\": \"array\", \"minItems\": 1, \"items\": {\"type\": \"object\", \"required\": [\"codigo\", \"tasa_anual\", \"monto_min\", \"monto_max\", \"plazo_min\", \"plazo_max\"], \"properties\": {\"codigo\": {\"type\": \"string\"}, \"tasa_anual\": {\"type\": \"number\"}, \"plazo_min\": {\"type\": \"integer\"}, \"plazo_max\": {\"type\": \"integer\"}}}};",
                  "pm.test(\"El cuerpo cumple el esquema\", function () {",
                  "    pm.response.to.have.jsonSchema(esquema);",
                  "});",
                  "pm.test(\"Incluye el crédito PERSONAL con tasa de 18 %\", function () {",
                  "    const personal = pm.response.json().find(p => p.codigo === \"PERSONAL\");",
                  "    pm.expect(personal, \"producto PERSONAL\").to.be.an(\"object\");",
                  "    pm.expect(personal.tasa_anual).to.eql(18);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/productos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "productos"
              ]
            }
          }
        },
        {
          "name": "Simular crédito PERSONAL Q50,000 a 36 meses",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código de respuesta 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const esquema = {\"type\": \"object\", \"required\": [\"cuota_mensual\", \"total_a_pagar\", \"total_intereses\", \"producto\"], \"properties\": {\"cuota_mensual\": {\"type\": \"number\"}, \"total_a_pagar\": {\"type\": \"number\"}, \"total_intereses\": {\"type\": \"number\"}}};",
                  "pm.test(\"El cuerpo cumple el esquema\", function () {",
                  "    pm.response.to.have.jsonSchema(esquema);",
                  "});",
                  "pm.test(\"Cuota, total e intereses coinciden con la fórmula (RNF-06)\", function () {",
                  "    const r = pm.response.json();",
                  "    pm.expect(r.cuota_mensual).to.eql(1807.62);",
                  "    pm.expect(r.total_a_pagar).to.eql(65074.32);",
                  "    pm.expect(r.total_intereses).to.eql(15074.32);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/simulador",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "simulador"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"producto_codigo\": \"PERSONAL\",\n  \"monto\": 50000,\n  \"plazo_meses\": 36\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Simular fuera de rango (monto y plazo)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código de respuesta 400\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "const esquema = {\"type\": \"object\", \"required\": [\"error\", \"detalles\"], \"properties\": {\"error\": {\"type\": \"string\"}, \"detalles\": {\"type\": \"object\"}}};",
                  "pm.test(\"El cuerpo cumple el esquema\", function () {",
                  "    pm.response.to.have.jsonSchema(esquema);",
                  "});",
                  "pm.test(\"Reporta error en monto y en plazo\", function () {",
                  "    const d = pm.response.json().detalles;",
                  "    pm.expect(d).to.have.property(\"monto\");",
                  "    pm.expect(d).to.have.property(\"plazo_meses\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
